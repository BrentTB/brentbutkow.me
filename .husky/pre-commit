#!/usr/bin/env sh
set -e

BIN=./node_modules/.bin
NL='
'

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
STAGED_TS=$(echo "$STAGED" | grep -E '\.(ts|tsx)$' || true)

# Independent checks run in parallel; name each so a failure says which one.
# (full tsc + eslint + test suite still run in CI on PRs)
jobs=""
npm run typecheck:fast & jobs="$jobs typecheck:$!"
if [ -n "$STAGED_TS" ]; then
  echo "$STAGED_TS" | tr '\n' '\0' | xargs -0 $BIN/eslint & jobs="$jobs eslint:$!"
  echo "$STAGED_TS" | tr '\n' '\0' | xargs -0 $BIN/vitest related --run & jobs="$jobs vitest:$!"
fi
fail=0
for job in $jobs; do
  name=${job%%:*}
  wait "${job#*:}" || { echo "✖ $name failed"; fail=1; }
done
[ "$fail" -eq 0 ] || exit 1

# Prettier the staged files. A fully-staged file (index matches working tree)
# gets auto-formatted and re-staged for you. A partially-staged file has
# unstaged hunks — auto-staging would sweep those in, so we fail instead and
# let you stage the formatting yourself.
if [ -n "$STAGED" ]; then
  DIRTY=$(echo "$STAGED" | tr '\n' '\0' | xargs -0 $BIN/prettier --list-different --ignore-unknown || true)
  if [ -n "$DIRTY" ]; then
    UNSTAGED=$(git diff --name-only --diff-filter=ACMR)
    partial=""
    clean=""
    # Split on newlines only so paths with spaces stay intact.
    IFS="$NL"
    for f in $DIRTY; do
      if echo "$UNSTAGED" | grep -qxF "$f"; then
        partial="$partial$f$NL"
      else
        clean="$clean$f$NL"
      fi
    done
    unset IFS
    if [ -n "$clean" ]; then
      printf '%s' "$clean" | tr '\n' '\0' | xargs -0 $BIN/prettier --write --ignore-unknown
      printf '%s' "$clean" | tr '\n' '\0' | xargs -0 git add
      echo "✔ Prettier formatted and re-staged:"
      printf '%s' "$clean"
    fi
    if [ -n "$partial" ]; then
      echo "✖ Prettier needs to reformat partially-staged files:"
      printf '%s' "$partial"
      echo "  These have unstaged changes — format and stage them yourself, then commit again."
      exit 1
    fi
  fi
fi
